# Backend runtime configuration. Replace placeholders locally; never commit secrets.
APP_NAME=AI Privacy Firewall
APP_VERSION=0.1.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://127.0.0.1
ALLOW_ONLY_LOGGING=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://privacy_firewall:change-me@postgres:5432/privacy_firewall
DATA_ROOT=/app/data
MODEL_DIRECTORY=/app/data/experiments/default
RAW_DATA_DIR=/app/data/raw
INTERIM_DATA_DIR=/app/data/interim
PROCESSED_DATA_DIR=/app/data/processed
EXTERNAL_DATA_DIR=/app/data/external
